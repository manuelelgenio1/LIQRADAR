# ============================================================
# LiqRadar · variables de entorno OPCIONALES (cópialo a .env)
# Las credenciales NUNCA van al frontend/bundle: solo las lee
# el servidor local (server.mjs) para firmar peticiones.
# Todo lo demás funciona SIN ninguna clave (endpoints públicos).
# ============================================================

# ---- Binance: brackets REALES de margen (recomendado, opcional) ----
# Crea una API key con permiso SOLO LECTURA (sin trading, sin retiros).
# Sin estas claves se usa la tabla pública documentada (calidad "estimada").
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Clusters de liquidación externos (opcional) ----
# Proveedor: "coinglass" o deja vacío para usar EXTERNAL_LIQUIDITY_URL.
EXTERNAL_LIQUIDITY_PROVIDER=
# Clave de CoinGlass API v4 (solo si el proveedor es "coinglass").
COINGLASS_API_KEY=
# Endpoint JSON personalizado de clusters (alternativa a CoinGlass).
# Debe devolver { clusters: [{ price, notional, side? }] } o un array.
EXTERNAL_LIQUIDITY_URL=
EXTERNAL_LIQUIDITY_TOKEN=

# ---- Puerto del servidor local ----
PORT=4173
